# Preferred for your existing setup: Google Apps Script bridge.
# Copy these three settings from your OLD working backend .env into backend/.env.
# Never paste or commit the real URL/secret; keep them local.
APPS_SCRIPT_BRIDGE_URL=
APPS_SCRIPT_BRIDGE_SECRET=
APPS_SCRIPT_BRIDGE_TIMEOUT_SECONDS=45

# Direct Google OAuth fallback (used only when bridge settings are both empty).
# Google OAuth credentials from Google Cloud Console. Never commit your real .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
# Gmail modify permits read, send, label, archive, and move-to-trash. Calendar access is optional but enabled for this build.
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/calendar.events

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Local storage paths. Token JSON is encrypted at rest under data/.
DATA_DIR=./data
DATABASE_PATH=./data/gmail_agent.sqlite3
DOWNLOADS_DIR=./data/downloads
LOCAL_FILES_DIR=./local_files

# Local AI via Ollama. No cloud model is called by this backend.
AI_ENABLED=true
AI_USE_CLOUD=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=75

# Background sync begins after the configured interval; it never sends or deletes messages.
AUTO_SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=300
SYNC_WINDOW_DAYS=30
SYNC_BATCH_SIZE=10
MAX_BULK_ACTION_COUNT=100
MAX_ATTACHMENT_BYTES=20971520
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
